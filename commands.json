[
   {
    "Name": "Network",
    "Children": [
      {
        "Name": "IP configuration",
        "Command": "Get-NetIPConfiguration"
      },
      {
        "Name": "Network adapters",
        "Command": "Get-NetAdapter"
      },
      {
        "Name": "DNS cache",
        "Command": "Get-DnsClientCache"
      }
    ]
  },
   {
    "Name": "System",
    "Children": [
      {
        "Name": "Computer information",
        "Command": "Get-ComputerInfo | Select-Object CsName, WindowsProductName, OsVersion"
      },
      {
        "Name": "Running processes",
        "Command": "Get-Process | Select-Object -First 10"
      },
      {
        "Name": "Windows services",
        "Command": "Get-Service | Select-Object -First 10"
      }
    ]
  },
  {
    "Name": "CMDNav",
    "Children": [
      {
        "Name": "Open shared commands",
        "Command": "Start-Process -FilePath (Join-Path (Get-Module CommandNavigator).ModuleBase 'commands.json') -Verb Open"
      },
      {
        "Name": "Open Settings",
        "Command": "Start-Process -FilePath (Join-Path (Get-Module CommandNavigator).ModuleBase 'settings.json') -Verb Open"
      }
    ]
  }
]